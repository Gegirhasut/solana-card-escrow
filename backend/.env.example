# Copy to .env and adjust. Never commit real secrets or keypairs.
ESCROW_DATABASE_URL=postgresql+asyncpg://escrow:escrow@localhost:5433/escrow
ESCROW_REDIS_URL=redis://localhost:6391/0
# Required with chain=rpc: random, >= 32 chars (openssl rand -hex 32)
ESCROW_WEBHOOK_SECRET=
ESCROW_AUTH_TIMEOUT_BUDGET_MS=1500
ESCROW_RPC_URL=http://127.0.0.1:8899
# Raise to ~0.8 on the rate-limited public devnet RPC
ESCROW_CONFIRM_POLL_S=0.15
ESCROW_PROGRAM_ID=8PyM1gDSssAqmn1qNPcwQ2y6nxFjUGwhPp81obhmAwpK
ESCROW_MINT=
# Token-2022 mints: TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
ESCROW_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
ESCROW_OPERATOR_KEYPAIR=~/.config/solana/card-escrow/operator.json
ESCROW_SETTLEMENT_AUTHORITY_KEYPAIR=~/.config/solana/card-escrow/settlement-authority.json
